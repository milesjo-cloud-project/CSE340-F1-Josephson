<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="container">
    <h1>Create an Account</h1>

    <% if (errors.length > 0) { %>
        <ul class="form-errors">
            <% errors.forEach((error) => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    <% } %>

<form action="/register" method="post" class="auth-form">
    <label for="name">Name</label>
    <input type ="text" id="name" name="name" value="<%= values.name || '' %>"
        required maxlength="100" autocomplete="name">

    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= values.email || '' %>"
    required maxlength="255" autocomplete="email">

    <label for="password">Password</label>
    <input type="password" id="password" name="password"
        required minlength="8" autocomplete="new-password">
        <p class="form-hint">At least 8 characters, with a number and a symbol.</p>

        <button type="submit" class="btn btn-red">Register</button>
</form>

<p>Already have an account? <a href="/login">Log in</a></p>
</main>
<%- include('partials/footer') %>
