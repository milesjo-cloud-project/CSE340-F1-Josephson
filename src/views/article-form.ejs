<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="container">
    <h1><%= title %></h1>

    <% if (errors.length > 0) { %>
        <ul class="form-errors">
            <% errors.forEach((error) => { %>
                <li><%= error %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="<%= action %>" method="post" class="auth-form article-form">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= values.title || '' %>"
            required maxlength="200">

        <label for="body">Body</label>
        <textarea id="body" name="body" rows="14" required><%= values.body || '' %></textarea>
        <p class="form-hint">Leave a blank line between paragraphs.</p>

        <button type="submit" class="btn btn-red"><%= button %></button>
    </form>

    <p><a href="/news">Cancel</a></p>
</main>
<%- include('partials/footer') %>