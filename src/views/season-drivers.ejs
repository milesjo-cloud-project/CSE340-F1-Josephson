<%- include('partials/head') %>
<%- include('partials/header')%>
<main class="container">
<section class="content">
  <h1 class="section-title"><%=title %></h1>
  <form class="team-filter" method="get" action="/seasons/<%= season %>/drivers">
    <label for="team">Team</label>
      <select name="team" id="team">
        <option value="">All teams</option>
        <% teams.forEach(t => { %> 
        <option value="<%= t %>" <%= t === team ? 'selected' : '' %>><%= t %></option>
        <% }); %>
      </select>
      <button type="submit">Filter</button>
  </form>
 <% if (drivers.length === 0) {%>
<p> No drivers found for <%= team %>.</p>
<% } else { %>
  <div class="driver-grid">
  <% drivers.forEach(driver => { %>
  <a class="driver-card" href="/seasons/<%= season %>/drivers/<%= driver.slug %>">
  <span class="driver-pos">P<%= driver.position %></span>
  <h2 class="driver-name"><%= driver.name %></h2>
  <p class="driver-team"><%= driver.team %></p>
  <p class="driver-points"><%= driver.points %> pts</p>
  </a>
  <% }); %>
 </div>
 <% } %>
 </section>
</main>
<%- include('partials/footer') %>
