<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
    <section class="content">
        <div class="container article-page">
            <p class="article-meta">
                <%= article.published_at.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                · By <%= article.author || 'Unknown author' %>
            </p>
            <h1 class="section-title"><%= article.title %></h1>

            <div class="article-body">
                <% article.body.split(/\n\s*\n/).forEach((paragraph) => { %>
                    <p><%= paragraph %></p>
                <% }) %>
            </div>

            <% if (user && (user.role === 'admin' || user.role === 'editor')) { %>
                <div class="article-actions">
                    <a href="/news/<%= article.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                    <form action="/news/<%= article.id %>/delete" method="post"
                        onsubmit="return confirm('Delete this article? This cannot be undone.');">
                        <button type="submit" class="btn btn-red btn-sm">Delete</button>
                    </form>
                </div>
            <% } %>

            <p><a href="/news" class="btn btn-link">← Back to News</a></p>
        </div>
    </section>
</main>
<%- include('partials/footer') %>