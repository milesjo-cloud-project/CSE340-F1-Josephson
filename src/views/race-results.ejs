<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
    <section class="driver-hero dark">
        <div class="container">
            <p class="driver-pos">Round <%= race.round %> . <%= race.date%></p>
            <h1 class="hero-title"><%= race.race %></h1>
            <p class="driver-team"><%= race.circuit %>, <%= race.city %>, <%= race.country %></p>
        </div>
    </section>

    <div class="container">
        <section class="content">
            <h2 class="section-title">Results</h2>

            <% if (results.length === 0) { %>
            <p> This race hasn't happened yet.</p>
        <% } else { %>
        <div class="table-scroll">
            <table class="results-table">
                <thead>
                    <tr>
                        <th>Pos</th><th>Driver</th><th>Team</th><th>Grid</th><th>Status</th><th>Pts</th>
                    </tr>
                </thead>
                <tbody>
                    <% results.forEach(r => { %>
                    <tr>
                    <td><%= r.finish %></td>
                    <td><a href="/seasons/<%= season %>/drivers/<%= r.slug %>"><%= r.driver %></a></td>
                    <td><%= r.team %></td>
                    <td><%= r.grid %></td>
                    <td><%= r.status %></td>
                    <td><%= r.racePoints + r.sprintPoints %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>

        <p class="back-link"><a href="/seasons/<%= season %>/races"> Back to races</a></p>
        </section>
    </div>
</main>
<%- include('partials/footer') %>