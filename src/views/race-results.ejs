<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
    <section class="driver-hero dark">
        <div class="container">
            <p class="driver-pos">Round <%= race.round %> . <%= race.date%></p>
            <h1 class="hero-title"><%= race.race %></h1>
            <p class="driver-team"><%= race.circuit %>, <%= race.city %>, <%= race.country %></p>
        </div>
    </section>

    <div class="container">
        <section class="content">
            <h2 class="section-title">Results</h2>

            <% if (results.length === 0) { %>
            <p> This race hasn't happened yet.</p>
        <% } else { %>
        <div class="table-scroll">
            <table class="results-table">
                <thead>
                    <tr>
                        <th>Pos</th><th>Driver</th><th>Team</th><th>Grid</th><th>Status</th><th>Pts</th>
                    </tr>
                </thead>
                <tbody>
                    <% results.forEach(r => { %>
                    <tr>
                    <td><%= r.finish %></td>
                    <td><a href="/seasons/<%= season %>/drivers/<%= r.slug %>"><%= r.driver %></a></td>
                    <td><%= r.team %></td>
                    <td><%= r.grid %></td>
                    <td><%= r.status %></td>
                    <td><%= r.racePoints + r.sprintPoints %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>
        <div class="comments" id="comments">
            <h2 class="section-title">Fan comments (<%= comments.length %>)</h2>

            <% if (comments.length === 0) { %> 
            <p class="form-hint">No comments yet.</p>
        <% } %>

        <% comments.forEach((c) => { %>
        <article class="comment">
            <p class="comment-meta">
                <strong><%= c.author %></strong>
                . <%= c.created_at.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                <% if (c.updated_at.getTime() > c.created_at.getTime())  {%>(edited) <% } %>
            </p>
            <p class="comment-body"><%= c.body %></p>
                        <% const ownsComment = user && user.id === c.user_id; %>
            <% if (ownsComment || isStaff) { %>
                <div class="comment-actions">
                    <% if (ownsComment) { %>
                        <a href="/comments/<%= c.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                    <% } %>
                    <form action="/comments/<%= c.id %>/delete" method="post"
                        onsubmit="return confirm('Delete this comment?');">
                        <button type="submit" class="btn btn-red btn-sm">Delete</button>
                    </form>
                </div>
            <% } %>
        </article>
        <% }) %>
        <% if (user) { %>
        <% if (commentErrors.length > 0) { %>
        <ul class="form-errors">
            <% commentErrors.forEach((error) => { %> 
            <li><%=error %></li>
            <% }) %>
        </ul>
        <% } %>
        <form action="/seasons/<%= season %>/races/<%= race.round %>/comments" method="post" class="auth-form comment-form">
            <label for="body">Add a comment</label>
            <textarea id="body" name="body" rows="4" required maxlength="1000"><%= commentBody %></textarea>
            <button type="submit" class="btn btn-red">Post comment</button>
        </form>
        <% } else { %> 
        <p><a href="/login">Log in</a> to join the conversation.</p>
        <% } %>
        </div>
        <p class="back-link"><a href="/seasons/<%= season %>/races"> Back to races</a></p>
        </section>
    </div>
</main>
<%- include('partials/footer') %>