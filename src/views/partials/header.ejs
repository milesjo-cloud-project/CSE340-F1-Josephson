    <header class="site-header dark">
        <div class="container header-inner">
            <a href="/" class="logo"><span class="logo-mark">F1</span><span class="logo-text">Formula 1</span></a>
            <nav class="main-nav" aria-label="Main Navigation">
                <ul class="menu">
                    <li class="menu-item"><a href="/drivers">Drivers</a></li>
                    <li class="menu-item"><a href="/teams">Teams</a></li>
                    <li class="menu-item"><a href="/races">Races</a></li>
                    <li class="menu-item"><a href="/news">News</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <a href="#ask" class="btn btn-red btn-sm">Ask a question</a>
                <% if (user) { %>
                    <span class="header-user"><%= user.name %></span>
                    <form action="/logout" method="post">
                        <button type="submit" class="btn btn-secondary btn-sm">Log Out</button>
                    </form>
                <% } else { %>
                    <a href="/login" class="btn btn-secondary btn-sm">Log In</a>
                    <a href="/register" class="btn btn-secondary btn-sm">Register</a>
                <% } %>
            </div>
        </div>
    </header>